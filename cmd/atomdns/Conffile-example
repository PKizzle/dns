{
    debug
    root handlers
    dns {
        addr [::]:1053
        limits {
            tcp -1
            run numcpu()*3
        }
    }
    doh {
        addr [::]:10053
        limits {
            run numcpu()*1
        }
    }
    dot {
        addr [::]:8053
        limits {
            run 1
        }
    }
    tls manual {
        cert global/testdata/test_cert.pem global/testdata/test_key.pem
    }
}

10.0.0.0/24 {
    log
    whoami
}

atoom.net {
    log
    dbfile dbfile/zone/testdata/db.example.org
}
