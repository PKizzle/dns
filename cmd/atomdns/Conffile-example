{
    log {
        debug
        # json
    }
    health
    metrics
    root handlers
    dns {
        addr [::]:1053
        limits {
            tcp -1
            run numcpu()*3
        }
    }
    doh {
        addr [::]:1443
        limits {
            run numcpu()*1
            inflight 100
        }
    }
    dot {
        addr [::]:8053
        limits {
            run 1
        }
    }
    tls manual {
        cert global/testdata/test_cert.pem global/testdata/test_key.pem
    }
}

10.0.0.0/24 {
    log
    whoami
}

example.org {
    log
    dbfile dbfile/zone/testdata/db.example.org {
        transfer
    }
}

miek.nl {
    log
    sign sign/testdata/db.miek.nl {
        key sign/testdata/Kmiek.nl.+013+59725
        zonemd
    }
    dbfile sign/testdata/db.miek.nl.signed
}
